# Build output
/carbonate
/dist/
*.test

# Local state — these hold credentials and decrypted user data.
# Never commit them.
auth.json
calcache-*.json
/state/
/coverage.out
/carbonate-gui

# Flatpak build output. The manifest and the generated module list are kept;
# what flatpak-builder makes from them is not.
/build/flatpak/.flatpak-builder/
/build/flatpak/builddir/
/build/flatpak/repo/
/build/flatpak/*.flatpak
